# EditorConfig — configuración de estilo/formato/lint para el proyecto.
#
# Es el equivalente en el ecosistema .NET a OXFmt (formateo) + OXLint (linting):
# el motor es `dotnet format`, que viene incluido en el .NET SDK y funciona 100% OFFLINE
# (importante aquí porque NuGet está bloqueado, ver AGENTS.local.md).
#
#   dotnet format whitespace   -> formateo puro          (≈ OXFmt / `oxfmt`)
#   dotnet format style        -> reglas de estilo IDExxxx (≈ OXLint / `oxlint`)
#   dotnet format analyzers    -> analizadores CAxxxx
#   dotnet format --verify-no-changes  -> modo CI/check (falla si algo no cumple)
#
# Las reglas están afinadas a la "house style" de Loupedeck/Options+ que ya usa el
# código (nombres de tipo del framework como String/Int32, `using` dentro del namespace,
# namespaces con bloque, llaves Allman, cualificación con `this.`), para que el formateo
# NO reescriba el código existente.

root = true

##############################
# Todos los archivos
##############################
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Archivos de configuración/marcado: 2 espacios
[*.{yml,yaml,json,xml,csproj,props,targets,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.svg]
insert_final_newline = false

##############################
# C#
##############################
[*.cs]
indent_size = 4

#### using ####
# `using` DENTRO del namespace (como en el código actual).
csharp_using_directive_placement = inside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# Marcar usings no utilizados (equivalente al "no-unused" de un linter).
dotnet_diagnostic.IDE0005.severity = warning

#### Namespaces ####
# Namespace con bloque `{ }` (NO file-scoped), como en el código actual.
csharp_style_namespace_declarations = block_scoped:warning
# El namespace es plano a propósito (Loupedeck lo requiere): NO exigir que coincida
# con la estructura de carpetas (p. ej. Commands/ sigue en el namespace raíz).
dotnet_diagnostic.IDE0130.severity = none

#### Cualificación `this.` ####
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning

#### Tipos: usar nombres del framework (String, Int32...) NO las palabras clave ####
# El código usa String/Int32/etc., así que preferimos el nombre del framework.
dotnet_style_predefined_type_for_locals_parameters_members = false:suggestion
dotnet_style_predefined_type_for_member_access = false:suggestion

#### var ####
# El código usa `var` de forma amplia. Se permite `var` en todos los casos pero en modo
# `silent`: ni el formateo ni el lint reescriben entre `var` y el tipo explícito.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

#### Llaves (estilo Allman: llave de apertura en línea nueva) ####
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
# Requerir llaves siempre (evita if/else de una línea sin llaves).
csharp_prefer_braces = true:suggestion

#### Indentación ####
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

#### Espaciado ####
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

#### Saltos de línea ####
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

#### Preferencias de expresión (suaves, para no reescribir el código actual) ####
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
# El código usa constructores clásicos y bloques `using (...) { }` a propósito.
csharp_style_prefer_primary_constructors = false:silent
csharp_prefer_simple_using_statement = false:silent

#### Convenciones de nombres ####
# El ORDEN importa: cada símbolo lo reclama la primera regla cuyo "symbols" encaja.
# Por eso las constantes/estáticos (PascalCase) van ANTES que los campos de instancia.

# 1) Constantes -> PascalCase (p. ej. `IconScale`, `BackgroundArgb`).
dotnet_naming_rule.constants_pascal_case.severity = suggestion
dotnet_naming_rule.constants_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_pascal_case.style = pascal_case

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

# 2) Campos static/static readonly -> PascalCase.
dotnet_naming_rule.static_fields_pascal_case.severity = suggestion
dotnet_naming_rule.static_fields_pascal_case.symbols = static_fields
dotnet_naming_rule.static_fields_pascal_case.style = pascal_case

dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_fields.required_modifiers = static

# 3) Campos privados de INSTANCIA -> _camelCase (como `_imgOn`).
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private,protected,private_protected

# 4) Tipos y miembros públicos -> PascalCase.
dotnet_naming_rule.types_pascal_case.severity = suggestion
dotnet_naming_rule.types_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_pascal_case.style = pascal_case

dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,interface,enum,property,method,event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = public,internal,protected

# Estilos reutilizados por las reglas anteriores.
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
