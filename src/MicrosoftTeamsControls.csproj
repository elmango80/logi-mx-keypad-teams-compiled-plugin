<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MicrosoftTeamsControls</AssemblyName>
    <RootNamespace>Loupedeck.MicrosoftTeamsControls</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <!-- Lint (estilo/analizadores) durante el build, guiado por .editorconfig.
         Equivalente a ejecutar OXLint en cada build. Los avisos NO rompen el build
         (TreatWarningsAsErrors=false) para no bloquear el flujo de desarrollo. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Necesario para que IDE0005 (usings sin usar) se detecte en el build.
         Se silencia CS1591 (falta comentario XML) para no inundar de avisos. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Iconos de estado de los comandos multiestado, embebidos en la DLL.
       Se leen por stream de recurso (Assembly.Location no es fiable en el runtime del LPS). -->
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedResources\*.svg" />
  </ItemGroup>

  <!-- SDK de Logi/Loupedeck referenciado desde la instalacion local del LogiPluginService.
       Ver AGENTS.local.md para el porque (no se usa el paquete NuGet). -->
  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
